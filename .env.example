# ===== 必須 =====
# セッションCookie署名用の秘密鍵(32文字以上)。次のコマンドで生成:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Discord Developer Portal > OAuth2 で取得
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# サービスの公開URL。Discordに登録するRedirect URIは「{BASE_URL}/auth/callback」になる
BASE_URL=http://localhost:8000

# ===== 推奨 =====
# 利用を許可するDiscordユーザーID(カンマ区切り)。空だと「Discordアカウントを持つ誰でも」利用可能。
# 公開前に必ず自分のIDなどを設定すること。
ALLOWED_DISCORD_IDS=

# ===== 任意(括弧内は既定値) =====
# PORT=8000
# BIND_HOST=0.0.0.0
# LOG_LEVEL=INFO
# DATABASE_PATH=data/app.db
# BROWSER_RUNTIME=process        # process | fake(fakeはUI確認用。実ブラウザは起動しない)
# DEFAULT_START_URL=https://example.com
# SCREEN_WIDTH=1280
# SCREEN_HEIGHT=720
# MAX_CONCURRENT_SESSIONS=1
# SESSION_MAX_SECONDS=1800
# IDLE_TIMEOUT_SECONDS=300
# TRUST_PROXY_HEADERS=false      # Cloud Run / nginx の背後ではtrue
# ENABLE_DOCS=false              # /docs を有効化(開発用)
