# ===== 必須 =====
APP_ENV=development
# セッションCookie署名用の秘密鍵(32文字以上)。次のコマンドで生成:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Discord Developer Portal > OAuth2 で取得
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# サービスの公開URL。Discordに登録するRedirect URIは「{BASE_URL}/auth/callback」になる
BASE_URL=http://localhost:8000

# ===== 推奨 =====
# 利用を許可するDiscordユーザーID(カンマ区切り)。本番環境では必須。
ALLOWED_DISCORD_IDS=

# ブラウザで検査してよい管理対象ドメイン(完全一致・カンマ区切り)。
# ワイルドカード、IPアドレス、ポート番号は使用不可。サブドメインは個別に列挙。
BROWSER_ALLOWED_HOSTS=example.com

# ===== 任意(括弧内は既定値) =====
# PORT=8000
# BIND_HOST=0.0.0.0
# LOG_LEVEL=INFO
# DATABASE_PATH=data/app.db
# BROWSER_RUNTIME=process        # process | fake(fakeはUI確認用。実ブラウザは起動しない)
# DEFAULT_START_URL=https://example.com
# APP_DOMAIN=browser.example.org          # OCI本番用(Caddy)
# APP_IMAGE=ghcr.io/oarikui/remotobrowser:latest  # OCI本番用(GHCR)
# APP_ENV=production                      # 本番用
# SCREEN_WIDTH=1280
# SCREEN_HEIGHT=720
# MAX_CONCURRENT_SESSIONS=1
# SESSION_MAX_SECONDS=1800
# IDLE_TIMEOUT_SECONDS=300
# TRUST_PROXY_HEADERS=false      # Caddyなどのリバースプロキシ背後ではtrue
# ENABLE_DOCS=false              # /docs を有効化(開発用)
